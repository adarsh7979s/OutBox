{
  "name": "outbox-email-scheduler",
  "version": "1.0.0",
  "private": true,
  "description": "ReachInbox Full-Stack Email Job Scheduler — BullMQ + Redis + PostgreSQL + Elasticsearch",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev:backend": "npm run dev --workspace=backend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "build": "npm run build --workspace=backend && npm run build --workspace=frontend",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "db:migrate": "npm run db:migrate --workspace=backend",
    "db:generate": "npm run db:generate --workspace=backend",
    "db:seed": "npm run db:seed --workspace=backend"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
