generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(uuid())
  googleId      String    @unique
  email         String    @unique
  name          String
  avatarUrl     String?
  slackToken    String?
  slackWebhook  String?
  slackChannel  String?
  slackTeamName String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  emails        Email[]
  senders       Sender[]

  @@map("users")
}

model Sender {
  id               String   @id @default(uuid())
  userId           String
  email            String
  name             String?
  etherealUser     String
  etherealPass     String
  maxEmailsPerHour Int      @default(50)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emails           Email[]

  @@unique([userId, email])
  @@map("senders")
}

model Email {
  id              String      @id @default(uuid())
  userId          String
  senderId        String
  recipientEmail  String
  subject         String
  body            String      @db.Text
  status          EmailStatus @default(SCHEDULED)
  scheduledAt     DateTime
  sentAt          DateTime?
  failedAt        DateTime?
  failureReason   String?
  bullJobId       String?     @unique
  idempotencyKey  String      @unique
  batchId         String?
  retryCount      Int         @default(0)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  sender          Sender      @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([scheduledAt])
  @@index([batchId])
  @@index([status])
  @@map("emails")
}

enum EmailStatus {
  SCHEDULED
  PROCESSING
  SENT
  FAILED
  RATE_LIMITED
  CANCELLED
}
