# ─────────────────────────────────────────────────────────────
# Frontend (Vite) environment variables
#
# Only variables prefixed with VITE_ are exposed to the browser.
# NEVER put secrets here — everything in this file ships to the client.
# ─────────────────────────────────────────────────────────────

# Base URL of the backend API, including the /api suffix.
#
# Local development: leave this UNSET. The app falls back to '/api' and
# Vite's dev proxy (vite.config.ts) forwards it to http://localhost:4000.
#
# Production (Vercel): set this to your deployed backend, e.g.
#   VITE_API_URL=https://your-backend.onrender.com/api
VITE_API_URL=
