# ===========================================================
# OutBox Email Scheduler — Backend Environment Config
#
# Copy to `.env` for local development:  cp .env.example .env
# `.env` is gitignored — never commit real secrets.
# In production, set these in the Render dashboard instead.
# ===========================================================

# ── Application ──────────────────────────────────────────────
# Render injects PORT automatically; do not set it there.
PORT=4000
NODE_ENV=development

# ── Database (PostgreSQL / Neon) ──────────────────────────────
# Local Docker default shown below.
# Neon: use the *pooled* connection string and keep sslmode=require, e.g.
#   postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=postgresql://outbox:outbox_pass@localhost:5432/outbox

# ── Redis (BullMQ queue + rate limiting) ─────────────────────
# Preferred in production: a single connection URL. Upstash provides one
# under "Redis Connect" → ioredis. The rediss:// scheme enables TLS.
#   REDIS_URL=rediss://default:<password>@<endpoint>.upstash.io:6379
# Leave REDIS_URL empty for local development; the host/port/password below
# are used instead.
REDIS_URL=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── Elasticsearch (OPTIONAL) ─────────────────────────────────
# Powers full-text search over subject/body. The app starts and runs
# normally when this is unreachable: indexing is skipped and the search
# endpoint returns no results. Safe to leave at the default in production
# if you are not running Elasticsearch.
ELASTICSEARCH_URL=http://localhost:9200

# ── Authentication / JWT ─────────────────────────────────────
# REQUIRED. Generate a strong random value, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ── Google OAuth 2.0 ─────────────────────────────────────────
# REQUIRED — the app exits at startup if these are missing.
# Credentials: https://console.cloud.google.com/apis/credentials
# GOOGLE_CALLBACK_URL must exactly match an Authorized redirect URI there.
# Production: https://<your-backend>.onrender.com/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# ── Slack OAuth 2.0 (optional integration) ───────────────────
# Sends a notification when a sender hits its hourly rate limit.
# Leave blank to disable. App: https://api.slack.com/apps
# Production: https://<your-backend>.onrender.com/api/slack/callback
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:4000/api/slack/callback

# ── Email delivery (Resend) ──────────────────────────────────
# REQUIRED — the backend exits at startup if either is missing.
# Outbound mail goes through the Resend HTTP API (https://resend.com).
# API key: Resend dashboard → API Keys. Never commit the real value.
RESEND_API_KEY=
# Must be an address on a domain you have verified in Resend.
# Use onboarding@resend.dev to test before your domain is verified —
# it can only deliver to the email you signed up with.
RESEND_FROM_EMAIL=onboarding@resend.dev
#
# Ethereal (the previous capture-only test SMTP service) is no longer used
# for sending. Sender rows still store the Ethereal credentials created
# when a sender is added, so those columns remain in the schema.

# ── BullMQ worker ────────────────────────────────────────────
# The worker runs in the same process as the API server.
WORKER_CONCURRENCY=5
# Minimum delay between individual email sends (ms)
MIN_SEND_DELAY_MS=2000

# ── Rate limiting ────────────────────────────────────────────
# Global maximum emails per hour (fallback)
MAX_EMAILS_PER_HOUR=200
# Per-sender maximum (overrides global when set on a sender)
MAX_EMAILS_PER_HOUR_PER_SENDER=50

# ── CORS / frontend ──────────────────────────────────────────
# Browser origins allowed to call the API. Comma-separated for multiple
# (e.g. production plus a Vercel preview domain). No trailing slash.
#   CORS_ORIGIN=https://your-frontend.vercel.app,https://your-frontend-git-dev.vercel.app
CORS_ORIGIN=http://localhost:5173

# Base URL the backend redirects the browser back to after OAuth.
# Production: https://your-frontend.vercel.app
FRONTEND_URL=http://localhost:5173
