# ===========================================
# OutBox Email Scheduler — Environment Config
# ===========================================

# Server
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Database (PostgreSQL)
DATABASE_URL=postgresql://outbox:outbox_pass@localhost:5432/outbox

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Elasticsearch
ELASTICSEARCH_URL=http://localhost:9200

# Google OAuth 2.0
# Get credentials at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# JWT
JWT_SECRET=change-this-to-a-strong-random-secret
JWT_EXPIRES_IN=7d

# Slack OAuth 2.0
# Create app at: https://api.slack.com/apps
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:4000/api/slack/callback

# BullMQ Worker Configuration
WORKER_CONCURRENCY=5
# Minimum delay between individual email sends (ms)
MIN_SEND_DELAY_MS=2000

# Rate Limiting
# Global maximum emails per hour (fallback)
MAX_EMAILS_PER_HOUR=200
# Per-sender maximum (overrides global when set on a sender)
MAX_EMAILS_PER_HOUR_PER_SENDER=50

# Frontend URL (for OAuth redirects)
FRONTEND_URL=http://localhost:5173
